{
  "manifest_version": 3,
  "name": "问渠学堂 PPT 下载器",
  "version": "1.1.0",
  "description": "把问渠学堂课程回放左侧的 PPT 一次性下载为图片，支持打包 ZIP。",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://classroom.wqxt.cdut.edu.cn/*",
    "https://*.wqxt.cdut.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "问渠学堂 PPT 下载器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://classroom.wqxt.cdut.edu.cn/livingroom*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
